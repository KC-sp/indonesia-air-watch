generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ObservationKind {
  IQAIR
  OFFICIAL_ISPU
}

enum ProviderState {
  HEALTHY
  DEGRADED
  UNAVAILABLE
}

model UserSettings {
  id                 Int      @id @default(1)
  nationalSample     Json     @default("[]")
  officialAllowlist  Json     @default("[\"indonesia.go.id\",\"kemenlh.go.id\",\"menlhk.go.id\",\"klhk.go.id\",\"bmkg.go.id\",\"bnpb.go.id\",\"data.go.id\",\"jakarta.go.id\"]")
  alertThreshold     Int?
  alertsEnabled      Boolean  @default(false)
  dailySummaryHour   Int      @default(20)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model TrackedLocation {
  id         String   @id @default(cuid())
  provider   String
  city       String
  state      String?
  country    String   @default("Indonesia")
  stationId  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@unique([provider, city, state])
}

model AirObservation {
  id          String          @id @default(cuid())
  provider    String
  providerId  String?
  kind        ObservationKind
  metric      String
  value       Int
  category    String?
  period      String?
  city        String
  region      String?
  station     String?
  sourceUrl   String
  observedAt  DateTime
  fetchedAt   DateTime        @default(now())
  metadata    Json?
  @@unique([provider, providerId, metric, observedAt])
  @@index([city, fetchedAt])
}

model HourlyDispatch {
  id         String   @id @default(cuid())
  hourBucket DateTime @unique
  status     String   @default("SENDING")
  sentAt     DateTime?
  error      String?
  createdAt  DateTime @default(now())
}

model DailyDispatch {
  id         String   @id @default(cuid())
  dayBucket  DateTime @unique
  status     String   @default("SENDING")
  sentAt     DateTime?
  error      String?
  createdAt  DateTime @default(now())
}

model ProviderHealth {
  provider      String        @id
  state         ProviderState @default(UNAVAILABLE)
  lastSuccessAt  DateTime?
  lastFailureAt  DateTime?
  errorSummary  String?
  updatedAt     DateTime      @updatedAt
}

model NewsCache {
  id        String   @id @default(cuid())
  topic     String   @unique
  content   Json
  fetchedAt DateTime @default(now())
  expiresAt DateTime
}

model SourceCandidate {
  id              String   @id @default(cuid())
  agency          String
  domain          String
  details         Json
  confidenceScore Int
  recommendation  String
  reviewedAt      DateTime @default(now())
}

model ApprovedSource {
  id          String   @id @default(cuid())
  candidateId String   @unique
  approvedBy  String
  approvedAt  DateTime @default(now())
  config      Json
}

model ProviderQuotaUsage {
  id       String   @id @default(cuid())
  provider String
  bucket   DateTime
  count    Int      @default(0)
  @@unique([provider, bucket])
}
